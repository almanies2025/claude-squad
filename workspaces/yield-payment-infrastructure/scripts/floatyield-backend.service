[Unit]
Description=FloatYield Backend API
After=network.target

[Service]
Type=simple
WorkingDirectory=/mnt/c/Users/User/Documents/GitHub/claude-squad/workspaces/yield-payment-infrastructure/backend
ExecStart=/usr/bin/python3 -m uvicorn app.main:app --host 0.0.0.0 --port 8000
Restart=always
RestartSec=5
StandardOutput=append:/tmp/floatyield-backend.log
StandardError=append:/tmp/floatyield-backend.log

[Install]
WantedBy=multi-user.target
