[Unit]
Description=FloatYield Frontend (Next.js)
After=network.target floatyield-backend.service
Requires=floatyield-backend.service

[Service]
Type=simple
WorkingDirectory=/mnt/c/Users/User/Documents/GitHub/claude-squad/workspaces/yield-payment-infrastructure/apps/web
ExecStart=/usr/bin/npm run dev
Restart=always
RestartSec=10
